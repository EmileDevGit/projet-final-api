@startuml
left to right direction
 
actor Utilisateur
actor Mentor
actor Administrateur
 
rectangle "public"{
Utilisateur --> (Parcourir la bibliothèque)
Utilisateur --> (Filtrer par catégorie)
Utilisateur --> (Filtrer par mot-clé)
Utilisateur --> (Consulter une ressource)
Utilisateur --> (Télécharger une ressource)
Utilisateur --> (Consulter son espace de savoir)
Utilisateur --> (ajouter une ressource a son espace de savoir)
Utilisateur --> (Évaluer un mentor)
 
 
Mentor --> (Créer une ressource)
Mentor --> (modifier une ressource)
Mentor --> (supprimer une ressource)
Mentor --> (Gérer la visibilité d'une ressource)
Mentor --> (Associer une ressource a une catégorie)
Mentor --> (Associer une ressource a une collection)
Mentor --> (Créer une collection)
Mentor --> (Modifier une collection)
Mentor --> (supprimer une collection)
Mentor --> (Gérer la visibilité d'une collection)
Mentor --> (Associer une collection a une catégorie)
Mentor --> (Contacter un administrateur)
}
 
rectangle "privé"{
Administrateur --> (Créer une catégorie)
Administrateur --> (Modifier une catégorie)
Administrateur --> (supprimer une catégorie)
Administrateur --> (lister les utilisateurs)
Administrateur --> (bannir un utilisateurs)
rectangle "public"{
 
Administrateur --> Mentor
Mentor --> Utilisateur
 
 
