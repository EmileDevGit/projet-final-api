# ===== DATABASE ===== #
DATABASE_URL=mysql://user:password@localhost:3306/sapienta_db
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=your_db_name
MYSQL_USER=your_user
MYSQL_PASSWORD=your_user_password
SECRET_KEY=your_super_sercure_secret_key
ALGORITHM=your_algorithm

# ===== AUTH ===== #
JWT_ALGORITHM=your_jwt_algorithm
JWT_SECRET=your_auth_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_PROJECT_NAME=Default_auth_name
AUTH_API_VERSION="0.0.0"
TOKEN_ENDPOINT="http://auth_container:auth_port/token"
TOKEN_VALIDATE_ENDPOINT="http://auth_container:auth_port/token/validate"
